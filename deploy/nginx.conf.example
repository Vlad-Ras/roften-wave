# Put into an existing nginx server block with TLS configured by certbot.
# The 127.0.0.1 binding prevents direct access to the UI through the public IP.
server {
    listen 80;
    server_name wave.roften.ru;
    # Configure TLS and HTTPS before public deployment; do not expose logins over plain HTTP.
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl http2;
    server_name wave.roften.ru;
    ssl_certificate /etc/letsencrypt/live/wave.roften.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wave.roften.ru/privkey.pem;
    client_max_body_size 1m;
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 65s;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
    }
}
