# Copy to .env; do NOT commit the real .env file.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
APP_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_SECURE_COOKIES=true
APP_DATA_DIR=/data
PUBLIC_APP_URL=https://wave.roften.ru
PUBLIC_RADIO_URL=https://roften.ru/listen/radio/radio.mp3

# Yandex Music account subscription + OAuth token, available from authorized personal client.
YANDEX_MUSIC_TOKEN=

# AzuraCast: Streamers/DJ Accounts -> Connection Information -> Icecast Clients.
# When on another Docker network, connect via host.docker.internal + published DJ port.
AZURACAST_DJ_HOST=host.docker.internal
AZURACAST_DJ_PORT=8005
AZURACAST_DJ_MOUNT=/live
AZURACAST_DJ_USERNAME=
AZURACAST_DJ_PASSWORD=
AZURACAST_MP3_BITRATE=160k

# Optional station now-playing metadata API. All three required to enable.
# Use internal AzuraCast HTTP(S) origin, independent of its public listener domain.
# Create an API key with station broadcasting permissions. Never put it in a URL.
AZURACAST_API_URL=
AZURACAST_API_KEY=
AZURACAST_STATION_ID=

# New Telegram bot created with @BotFather. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
# Only these numerical Telegram user IDs can control radio.
TELEGRAM_ADMIN_IDS=

# Keep true for normal operation. False disables the playback worker for diagnostics/tests.
AUTO_START=true
